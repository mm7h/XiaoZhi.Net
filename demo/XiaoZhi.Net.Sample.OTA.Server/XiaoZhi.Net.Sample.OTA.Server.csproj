<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<!-- Share the sample server's typed and legacy dictionary configuration conversion. -->
	<ItemGroup>
		<Content Update="appsettings*.json" ExcludeFromSingleFile="true" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\XiaoZhi.Net.Sample.Server\Configs\XiaoZhiConfigurationExtensions.cs" Link="Helpers\XiaoZhiConfigurationExtensions.cs" />
		<Compile Include="..\XiaoZhi.Net.Sample.Server\Configs\LenientStringConverter.cs" Link="Helpers\LenientStringConverter.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\server\XiaoZhi.Net.Server.Abstractions\XiaoZhi.Net.Server.Abstractions.csproj" />
	</ItemGroup>
	
</Project>
