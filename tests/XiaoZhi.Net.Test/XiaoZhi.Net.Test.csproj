  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.77.0" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\server\XiaoZhi.Net.Server\XiaoZhi.Net.Server.csproj" />
    <ProjectReference Include="..\..\src\server\XiaoZhi.Net.Server.Media\XiaoZhi.Net.Server.Media.csproj" />
  </ItemGroup>

</Project>
